<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Clippy Pet</title>
    <organization>io.github.adammatthewsteinberger</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="io.github.adammatthewsteinberger.clippy_pet.pkg"/>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.adammatthewsteinberger.clippy_pet.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.adammatthewsteinberger.clippy_pet.pkg" visible="false">
        <pkg-ref id="io.github.adammatthewsteinberger.clippy_pet.pkg"/>
    </choice>
    <pkg-ref id="io.github.adammatthewsteinberger.clippy_pet.pkg" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
